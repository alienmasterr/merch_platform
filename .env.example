# --- Сервер ---
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# --- Дані: memory (без БД) або postgres ---
PERSISTENCE=memory
# порт має збігатися з docker-compose.yml (5433)
DATABASE_URL=postgres://merch:merch@localhost:5433/merch

# --- Файли принтів: local | s3 | memory ---
STORAGE_DRIVER=local
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_URL=http://localhost:9000
# S3_BUCKET=merch-prints
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# --- Нова Пошта (порожньо = заглушка: 70 грн, ТТН DEV-...) ---
NOVA_POSHTA_API_KEY=
# NP_SENDER_CITY=Київ
# NP_SENDER_REF=
# NP_CONTACT_SENDER_REF=
# NP_SENDER_ADDRESS_REF=
# NP_SENDER_PHONE=

# --- LiqPay (порожньо = dev-заглушка оплати) ---
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true
PAYMENT_RESULT_URL=http://localhost:5173/payment-result

# --- Пошта (порожній SMTP_HOST = листи друкуються в консоль) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Merch Platform <no-reply@merch.local>
